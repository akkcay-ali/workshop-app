{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Workshop",
  "version": "0.3.0",
  "identifier": "app.workshop.desktop",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Workshop",
        "width": 1440,
        "height": 900,
        "minWidth": 900,
        "minHeight": 600,
        "center": true,
        "theme": "Dark",
        "dragDropEnabled": false,
        "backgroundColor": "#0D0E10"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "Ali",
    "category": "Productivity",
    "shortDescription": "Kişisel planlama ve referans panosu",
    "longDescription": "Workshop: projeler, günlük görevler, takvim ve referans panoları. Her proje tek bir .workshop dosyasıdır.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": [
          "workshop"
        ],
        "name": "Workshop Projesi",
        "description": "Workshop proje dosyası",
        "role": "Editor",
        "mimeType": "application/x-workshop"
      }
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "Turkish",
          "English"
        ],
        "displayLanguageSelector": false
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDg5MTBCM0FDODJCMjg5M0EKUldRNmliS0NyTE1RaVpRZWdoY0pOVEpLT0xXaThhQnRwYzZTYmYwbTdiU2FLbEMxN0NWbS9aaVIK",
      "endpoints": [
        "https://github.com/akkcay-ali/workshop-app/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
